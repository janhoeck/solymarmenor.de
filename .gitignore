# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Idea
.idea

# Dependencies
node_modules
.pnp
.pnp.js

# Env files. Ignore every variant and re-include only the committed template,
# so a new one such as `.env.production` cannot slip in unnoticed.
.env*
!.env.example

# Testing
coverage

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Agent scratch
.superpowers/

# Camera originals set aside by `pnpm images:downscale`. A local safety net
# only — the originals are in the git history anyway.
.image-originals/

# Misc
.DS_Store
*.pem
