# Copy to `.env.local` and fill in. Never commit the filled-in file.

# Postgres connection string for the guestbook. Required at build time.
DATABASE_URL=

# Airbnb iCalendar export URL for the apartment. Carries an access token.
ICAL_APARTMENT=

# Airbnb iCalendar export URL for the house. Carries an access token.
ICAL_HOUSE=
