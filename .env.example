# Copy to `.env.local` and fill in. Never commit the filled-in file.

# Postgres connection string for the guestbook. Required at build time.
DATABASE_URL=

# Airbnb iCalendar export URL for the apartment. Carries an access token.
ICAL_APARTMENT=

# Airbnb iCalendar export URL for the house. Carries an access token.
ICAL_HOUSE=

# Canonical origin the site is served from. Read at runtime (a restart picks
# up a change, no rebuild needed) by canonical/hreflang URLs, every JSON-LD
# @id and url, and the Origin check on /api/vitals. Exception: /sitemap.xml
# and /robots.txt are statically prerendered, so their URLs are frozen at
# build time — changing this value there needs a rebuild, not just a restart.
# Falls back to https://solymarmenor.com when unset.
NEXT_PUBLIC_BASE_URL=
